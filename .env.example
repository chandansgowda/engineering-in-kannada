# GitHub Personal Access Token for API requests
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo:status, public_repo
VITE_GITHUB_TOKEN=your_github_token_here 
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID_HERE
# Public URL of the site, used for canonical links, the sitemap and social previews
VITE_SITE_URL=https://engineeringinkannada.in
